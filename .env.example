API_URL=https://api.github.com/repos/psf/requests/commits
API_PER_PAGE=30
API_MAX_RETRIES=3
API_TIMEOUT=15

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_NAME=data_platform
POSTGRES_USER=data_platform
POSTGRES_PASSWORD=your_password

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password

MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_USER=data_platform
MYSQL_PASSWORD=your_mysql_airbyte_password

# Airflow 3.1 training stack (replace every placeholder before starting)
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.7
AIRFLOW_UID=50000
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace_with_random_hex
AIRFLOW_REDIS_PASSWORD=replace_with_random_hex
AIRFLOW_FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW_API_SECRET_KEY=replace_with_random_secret
AIRFLOW_ADMIN_USERNAME=airflow_admin
AIRFLOW_ADMIN_PASSWORD=replace_with_strong_password
AIRFLOW_WEBSERVER_PORT=8081
